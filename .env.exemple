KV_REST_API_TOKEN=#Same
KV_REST_API_URL=#Same
KV_URL=#Same
REDIS_URL=#REDIS URL for rate limiting
SMTP_USER=# Depends on your SMTP provider, sometimes the email adress
SMTP_PASS=# Password of the previous user
SMTP_HOST=#SMTP host of your SMTP service
SMTP_PORT=#usually 465
PRIV_EMAIL=# The "From" email
BLOB_STORE_ID=# Vercel blob ID, from vercel/storage/blob
BLOB_READ_WRITE_TOKEN=# Blob Token
GOOGLE_API_KEY=#API key for Google PageSpeed, for the monitoring tool
CRON_SECRET=#Random string of characters