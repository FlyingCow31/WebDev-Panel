DATABASE_URL= # NEON DB URL
DATABASE_URL_POOLED= # NEON DB POOLED URL (sometimes you don't need it)
JWT_SECRET=#A random phrase/characters 
CHARACTER_NEW_PASSWORD=#A sample of characters to build the temporary password to reset. IMPORTANT: if the sample contains specials, the user WILL be able to connect without reseting their password.
JWT_EXPIRES_IN=#number in seconds 
