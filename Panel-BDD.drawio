                <mxCell id="c751" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" value="&lt;b&gt;MLD (notation textuelle)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CLIENT&lt;/b&gt; ( &lt;u&gt;client_id&lt;/u&gt;, client_nom, client_pren, client_bus, client_siret, client_tel, client_contact_mail, client_add, client_notes, client_created_at )&lt;br&gt;&lt;br&gt;&lt;b&gt;UTILISATEUR&lt;/b&gt; ( &lt;u&gt;user_id&lt;/u&gt;, #client_id, user_mail, user_password, user_role, user_last_login_at, user_created_at )&lt;br&gt;&lt;br&gt;&lt;b&gt;PROJET&lt;/b&gt; ( &lt;u&gt;proj_id&lt;/u&gt;, #client_id, proj_nom, proj_type, proj_deadline, proj_prix, proj_tps_rem, proj_tps_non_rem, proj_info, proj_created_at, proj_done_at )&lt;br&gt;&lt;br&gt;&lt;b&gt;AVANCEE&lt;/b&gt; ( &lt;u&gt;avancee_id&lt;/u&gt;, #proj_id, #document_id, avancee_etape, avancee_statut, avancee_titre, avancee_message, avancee_date, avancee_visible_client, avancee_mail_sent_at, avancee_created_at )&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTURE&lt;/b&gt; ( &lt;u&gt;facture_id&lt;/u&gt;, #proj_id, facture_num, facture_mont, facture_lien, facture_date, facture_pay_deadline, facture_paid_at, facture_temps )&lt;br&gt;&lt;br&gt;&lt;b&gt;DOCUMENT&lt;/b&gt; ( &lt;u&gt;document_id&lt;/u&gt;, #proj_id, document_nom, document_type, document_link, document_visible_client, document_created_at )&lt;br&gt;&lt;br&gt;&lt;b&gt;SITE&lt;/b&gt; ( &lt;u&gt;site_id&lt;/u&gt;, #proj_id, site_domain, site_ssl_expires_at, site_lighthouse, site_checked_at )&lt;br&gt;&lt;br&gt;&lt;b&gt;TODO&lt;/b&gt; ( &lt;u&gt;todo_id&lt;/u&gt;, #proj_id, todo_title, todo_done, todo_due, todo_reminder_sent_at, todo_created_at )&lt;br&gt;&lt;br&gt;&lt;b&gt;CLAUSE&lt;/b&gt; ( &lt;u&gt;clause_id&lt;/u&gt;, clause_key, clause_text )&lt;br&gt;&lt;br&gt;&lt;b&gt;DEPENSE&lt;/b&gt; ( &lt;u&gt;depense_id&lt;/u&gt;, #proj_id, depense_label, depense_categorie, depense_mont, depense_date )&lt;br&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39;